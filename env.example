# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/recta

# Auth mode (required): 'local' (no Firebase) or 'firebase' (default)
AUTH_MODE=local
# Required when AUTH_MODE=local. Strong secret, min 32 chars (e.g. openssl rand -base64 48)
AUTH_JWT_SECRET=
# Local-mode token lifetime in hours (optional, default 720 = 30 days)
# AUTH_TOKEN_TTL_HOURS=720
# Local mode: set to false to close sign-ups once your users exist (POST /auth/register then answers 403)
# AUTH_ALLOW_REGISTRATION=true
# Firebase-mode only: this backend's PUBLIC Firebase web API key, advertised via GET /auth/config
# AUTH_FIREBASE_WEB_API_KEY=

# Firebase Admin (only when AUTH_MODE=firebase) - use either option:
# Option A: Path to service account JSON (do not commit the file)
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Option B: Individual credentials (e.g. for Railway)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Redis (optional)
# REDIS_URL=redis://localhost:6379

# Server
PORT=3000
NODE_ENV=development

# Swagger (optional - if set, Swagger UI is protected with basic auth)
# SWAGGER_USERNAME=admin
# SWAGGER_PASSWORD=your-secure-password

# First run - run migrations on startup (optional)
# FIRST_RUN=false

# CORS - comma-separated allowed origins
# ALLOWED_ORIGINS=https://your-frontend.app,http://localhost:5173
